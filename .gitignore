# Secrets - jgo-config.php holds the Resend API key. Never commit it.
jgo-config.php
*config.local.php
.env
.env.*
*.pem
*.key

# Client-supplied binary assets are delivered separately, not version controlled
veterans/assets/*
!veterans/assets/.gitkeep

