{
  // Cloudflare config: pure static hosting. The form posts directly from the
  // browser to Web3Forms (see WEB3FORMS_ACCESS_KEY in veterans/index.html),
  // so no Worker code runs here. The name matches the Worker the first
  // deploy created, so pushes to main keep updating the same URL.
  "name": "veterans-landing-page",
  "compatibility_date": "2026-08-25",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "veterans"
  }
}
